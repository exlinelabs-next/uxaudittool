    {
      "name": "Rate Limiting",
      "description": "5 audits per IP per hour. The 6th request returns 429. Rate limit fires before the stream starts so the response is plain JSON.",
      "item": [
        {
          "name": "Trigger rate limit (send 6 times)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Rate limit check fires before stream - response is plain JSON",
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Either 400 (under limit) or 429 (rate limited)', () => {",
                  "    pm.expect([400, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 429) {",
                  "    pm.test('429 has user-friendly message mentioning hour', () => {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.error).to.include('hour');",
                  "    });",
                  "    console.log('Rate limit hit - working correctly');",
                  "} else {",
                  "    console.log('Under rate limit - send this request again to build up to 5');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"url\": \"not-a-url\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/audit",
              "host": ["{{base_url}}"],
              "path": ["api", "audit"]
            },
            "description": "Send this 6+ times. Runs 1-5 return 400 (invalid URL - no PageSpeed quota burned). Run 6+ returns 429.\n\nTo reset: restart the dev server (rate limit is in-memory)."
          }
        }
      ]
    }
  ]
