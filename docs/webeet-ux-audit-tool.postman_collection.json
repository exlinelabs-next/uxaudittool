            "description": "Minimal HTML-only page. Fast to audit, useful for checking all 6 categories return data correctly."
          }
        },
        {
          "name": "Audit - HTTP (not HTTPS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('HTTPS trust check should fail', () => {",
                  "  const trustChecks = json.categories.trust?.checks ?? [];",
                  "  const httpsCheck = trustChecks.find(c => c.id === 'https');",
                  "  if (httpsCheck) pm.expect(httpsCheck.status).to.equal('fail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"url\": \"http://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/audit",
              "host": ["{{base_url}}"],
              "path": ["api", "audit"]
            },
            "description": "Tests that HTTP (non-secure) sites are audited and the HTTPS trust check correctly fails."
          }
        }
      ]
    },
