    {
      "name": "Rate Limiting",
      "description": "The API allows 5 audits per IP per hour. The 6th request returns 429.",
      "item": [
        {
          "name": "Trigger rate limit (run 6 times)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// On the 6th+ run this should 429",
                  "// On runs 1-5 it will 400 (invalid URL kept intentionally to not burn PageSpeed quota)",
                  "const status = pm.response.code;",
                  "pm.test('Either 400 (under limit) or 429 (over limit)', () => {",
                  "  pm.expect([400, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 429) {",
                  "  pm.test('429 has user-friendly message', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.include('hour');",
                  "  });",
                  "  console.log('Rate limit hit - working correctly');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"url\": \"not-a-url\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/audit",
              "host": ["{{base_url}}"],
              "path": ["api", "audit"]
            },
            "description": "Send this request 6+ times. Runs 1-5 return 400 (invalid URL). Run 6+ returns 429 with the rate limit message.\n\nNote: rate limit is per IP per hour. Restart the dev server to reset."
          }
        }
      ]
